{
  "provider": "flotorch",
  "provider_settings": {
    "api_key": "$FLOTORCH_API_KEY",
    "model": "flotorch/gemini-flash",
    "base_url": "https://qa-gateway.flotorch.cloud/openai/v1",
    "headers": {}
  },
  "bench": {
    "concurrency": 10,
    "requests": 50,
    "requests_per_second": 5.0,
    "duration_sec": 0,
    "ramp_up_sec": 0,
    "timeout_sec": 60,
    "max_tokens": 1024,
    "stream": true,
    "generate_prompts": false,
    "generate_prompts_count": null,
    "prompt_mean_input_tokens": 550,
    "prompt_stddev_input_tokens": 250,
    "prompt_mean_output_tokens": 150
  },
  "input_file": "",
  "report": {
    "format": "console"
  }
}