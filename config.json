{
  "provider": "flotorch",
  "provider_settings": {
    "api_key": "$FLOTORCH_API_KEY",
    "model": "flotorch/gemini-flash",
    "base_url": "https://gateway.flotorch.cloud/openai/v1",
    "headers": {}
  },
  "bench": {
    "concurrency": 100,
    "requests": 1000,
    "requests_per_second": 10,
    "duration_sec": 0,
    "ramp_up_sec": 0,
    "timeout_sec": 60,
    "max_tokens": 1024,
    "stream": true,
    "generate_synthetic_prompts": true,
    "generate_prompts": false,
    "min_output_tokens": 700,
    "prompt_input_tokens": 1024,
    "generate_prompts_count": null
  },
  "report": {
    "format": "console"
  }
}
