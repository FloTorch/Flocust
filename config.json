{
  "provider": "flotorch",
  "provider_settings": {
    "api_key": "$FLOTORCH_API_KEY",
    "model": "flotorch/gemini-flash",
    "base_url": "https://qa-gateway.flotorch.cloud/openai/v1",
    "headers": {}
  },
  "bench": {
    "concurrency": 10,
    "requests": 100,
    "requests_per_second": 0,
    "duration_sec": 0,
    "ramp_up_sec": 0,
    "timeout_sec": 300,
    "max_output_tokens": 1024,
    "stream": true,
    "instruct_output_tokens": true,
    "generate_prompts": false,
    "generate_prompts_count": null
  },
  "input_file": "./input_examples/prompts_1024.jsonl",
  "report": {
    "format": "console"
  }
}
