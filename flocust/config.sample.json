{
  "provider": "openai",
  "provider_settings": {
    "api_key": "$OPENAI_API_KEY",
    "model": "gpt-4o-mini",
    "base_url": "https://api.openai.com/v1",
    "headers": {}
  },
  "bench": {
    "concurrency": 10,
    "requests": 100,
    "requests_per_second": 5.0,
    "duration_sec": 0,
    "ramp_up_sec": 0,
    "timeout_sec": 60,
    "max_tokens": 1024,
    "stream": true,
    "generate_prompts": false,
    "generate_prompts_count": null
  },
  "input_file": "prompts.jsonl",
  "report": {
    "format": "console"
  }
}
